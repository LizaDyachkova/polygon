struct Edge { // структура ребра графа 
    std::string coordinates; // координаты конечной точки ребра  
    double weight;           // Вес ребра
};

class Node { // узел графа 
public: 
    std::string coordinates; // lon,lat
    std::vector<Edge> edges; // список ребер, исходящих из данного узла в векторе

    Node(const std::string& coords) : coordinates(coords) {}
}; // конструктор, принимающий строку с координатами узла 
// он присваивает координаты для каждого узла при его создании.

class Graph { // граф, как контейнер для узлов
public:
    std::unordered_map<std::string, Node*> nodes; // контейнер для узлов графа

    ~Graph() {
        for (auto& pair : nodes) {
            delete pair.second; // Освобождение памяти
        }
    }

    void addNode(const std::string& coords) { /// новый узел в граф, принимает уникальный идентификатор узла
        if (nodes.find(coords) == nodes.end()) { // проверка на существование ранее такого узла
            nodes[coords] = new Node(coords); // создаетмя новый объект и добавляется в контейнер
        }
    }

    void addEdge(const std::string& from, const std::string& to, double weight) { // добавление ребер, если узлы существуют  
        if (nodes.find(from) != nodes.end() && nodes.find(to) != nodes.end()) {
            nodes[from]->edges.push_back({ to, weight });
        }
        else {
            std::cerr << "Error: Node " << from << " or Node " << to << " does not exist.\n";
        }
    }

    double dfs(const std::string& start, const std::string& end, std::vector<std::string>& shortestPath) {
        if (nodes.find(start) == nodes.end() || nodes.find(end) == nodes.end()) { // проверка наличиия узлов 
            std::cerr << "Error: One or both nodes not found for DFS.\n";
            return std::numeric_limits<double>::infinity();
        }

        std::unordered_map<std::string, bool> visited; // для посещенных узлов
        std::vector<std::string> currentPath; // для текущего пути
        double minWeight = std::numeric_limits<double>::infinity(); // минимального пути, изначально бесконечность

        std::stack<std::pair<std::string, std::pair<double, std::vector<std::string>>>> stack; // узел, вес, путь
        stack.push({ start, {0, {}} }); // начальное помещаем

        while (!stack.empty()) { 
            auto current = stack.top(); // извлекаем верхний элемент стека
            stack.pop();

            std::string currentNode = current.first; // из верхнего элемента стека берем тек узел
            double currentWeight = current.second.first; // вес пути до тек узла 
            currentPath = current.second.second; // список узлов, которые прошли, т.е текущий путь 
            currentPath.push_back(currentNode); // текущий узел добавл в путь 
            if (currentNode == end) { // если тек узел совпадает с конечным
                if (currentWeight < minWeight) { // для кратчайшего пути 
                    minWeight = currentWeight;
                    shortestPath = currentPath; // обновляем, нашли более короткий 
                }
                continue;
            }

            for (const Edge& edge : nodes[currentNode]->edges) { // цикл для перебора всех ребер
                if (!visited[edge.coordinates]) { // проверка на посещение узла
                    visited[edge.coordinates] = true; // помещаем посещенным
                    stack.push({ edge.coordinates, {currentWeight + edge.weight, currentPath} }); // доб в стек новый узел, вес нового пути, новый путь
                }
            }
        }

        return minWeight; // возвращаем мин вес
    }

    double bfs(const std::string& start, const std::string& end, std::vector<std::string>& shortestPath) {
        std::unordered_map<std::string, bool> visited; // был ли узел посещен
        std::unordered_map<std::string, std::string> parent; // родительский узел сохраняет
        std::unordered_map<std::string, double> weights; // вес пути до каждого узла
        std::queue<std::string> queue; //очередь, здесь узлы которые нужно исследовать

        for (const auto& pair : nodes) { // 
            visited[pair.first] = false; // узел не был посещен
            weights[pair.first] = 0; // вес 0
        }

        queue.push(start);
        visited[start] = true;
        parent[start] = "";

        while (!queue.empty()) {
            std::string current = queue.front(); // извлекаем 1 эл очереди
            queue.pop(); // и удаляем 

            for (const Edge& edge : nodes[current]->edges) { // если не посещен для каждого соседа тек узла
                if (!visited[edge.coordinates]) {
                    visited[edge.coordinates] = true; // сосед посещ
                    parent[edge.coordinates] = current; // родитель - тек узел 
                    weights[edge.coordinates] = weights[current] + edge.weight;
                    queue.push(edge.coordinates); // сосед в очередь

                    if (edge.coordinates == end) { // если текущий сосед - это конечный узел, то путь найден 
                        std::vector<std::string> path;
                        for (std::string at = end; at != ""; at = parent[at]) {
                            path.push_back(at);
                        }
                        std::reverse(path.begin(), path.end());
                        shortestPath = path;
                        return weights[end];
                    }
                }
            }
        }

        return std::numeric_limits<double>::infinity();
    }

    double dijkstra(const std::string& start, const std::string& end, std::vector<std::string>& shortestPath) { // на существование узла 
        if (nodes.find(start) == nodes.end() || nodes.find(end) == nodes.end()) {
            std::cerr << "Ошибка: One or both nodes not found.\n";
            return std::numeric_limits<double>::infinity();
        }

        std::unordered_map<std::string, double> distances; // мин расстояние от начального до конечного узла
        std::unordered_map<std::string, std::string> previous; // информация о предыдущем узле 
        std::priority_queue<std::pair<double, std::string>, std::vector<std::pair<double, std::string>>, std::greater<std::pair<double, std::string>>> minHeap;

        for (const auto& pair : nodes) {
            distances[pair.first] = std::numeric_limits<double>::infinity(); // для каждого узла устанавливаем бесконечность
            previous[pair.first] = ""; // нет родителей у узла 
        }

        distances[start] = 0; // расстояние начального узла 0
        minHeap.push({ 0, start });

        while (!minHeap.empty()) { // извлекаем пару расстояние / узел
            std::pair<double, std::string> topElement = minHeap.top();
            double currentDistance = topElement.first; // пока в куче есть элементы, извлекаем узел с мин расстоянием
            std::string currentNode = topElement.second;
            minHeap.pop();
=
            if (currentNode == end) {
                break;
            }

            for (const Edge& edge : nodes[currentNode]->edges) {
                double newDistance = currentDistance + edge.weight; //Для каждого соседа текущего узла (из его рёбер nodes[currentNode]->edges) вычисляется новое расстояние до соседа,
                // добавляя вес рёбер к текущему расстоянию (newDistance = currentDistance + edge.weight).

                if (newDistance < distances[edge.coordinates]) { // обновляем расстояние 
                    distances[edge.coordinates] = newDistance;
                    previous[edge.coordinates] = currentNode;
                    minHeap.push({ newDistance, edge.coordinates }); // добавляем соседа в кучу с новым расстоянием 
                }
            }
        }

        std::vector<std::string> path;
        for (std::string at = end; at != ""; at = previous[at]) {
            path.push_back(at);
        }
        std::reverse(path.begin(), path.end());

        if (!path.empty() && path.front() == start) {
            shortestPath = path;
            return distances[end];
        }

        return std::numeric_limits<double>::infinity();
    }

    double aStar(const std::string& start, const std::string& end, std::vector<std::string>& shortestPath) {
        if (nodes.find(start) == nodes.end() || nodes.find(end) == nodes.end()) {
            std::cerr << "Ошибочка: One or both nodes not found.\n";
            return std::numeric_limits<double>::infinity();
        }

        std::unordered_map<std::string, double> gCosts; // стоимомть узла 
        std::unordered_map<std::string, double> fCosts; 
        std::unordered_map<std::string, std::string> cameFrom;
        auto cmp = [](const std::pair<double, std::string>& a, const std::pair<double, std::string>& b) {
            return a.first > b.first;
            };
        std::priority_queue<std::pair<double, std::string>, std::vector<std::pair<double, std::string>>, decltype(cmp)> openSet(cmp);

        gCosts[start] = 0;
        fCosts[start] = heuristic(start, end);
        openSet.push({ fCosts[start], start });

        while (!openSet.empty()) {
            std::string currentNode = openSet.top().second;
            openSet.pop();

            if (currentNode == end) {
                break;
            }

            for (const Edge& edge : nodes[currentNode]->edges) {
                double tentativeGCost = gCosts[currentNode] + edge.weight;

                if (gCosts.find(edge.coordinates) == gCosts.end() || tentativeGCost < gCosts[edge.coordinates]) {
                    cameFrom[edge.coordinates] = currentNode;
                    gCosts[edge.coordinates] = tentativeGCost;
                    fCosts[edge.coordinates] = tentativeGCost + heuristic(edge.coordinates, end);
                    openSet.push({ fCosts[edge.coordinates], edge.coordinates });
                }
            }
        }

        std::vector<std::string> path;
        for (std::string at = end; at != ""; at = cameFrom[at]) {
            path.push_back(at);
        }
        std::reverse(path.begin(), path.end());

        if (!path.empty() && path.front() == start) {
            shortestPath = path;
            return gCosts[end];
        }

        return std::numeric_limits<double>::infinity();
    }

    double heuristic(const std::string& a, const std::string& b) {
        return 0;
    }
};

void parseGraphInput(std::istream& inputStream, Graph& graph) {
    std::string line;
    while (std::getline(inputStream, line)) {
        std::size_t colonPos = line.find(':');
        if (colonPos != std::string::npos) {
            std::string coordinates = line.substr(0, colonPos);
            graph.addNode(coordinates);

            std::string edgesStr = line.substr(colonPos + 1);
            std::istringstream edgesStream(edgesStr);
            std::string edgeInfo;

            while (std::getline(edgesStream, edgeInfo, ';')) {
                if (edgeInfo.empty()) continue;

                std::size_t weightPos = edgeInfo.find_last_of(',');

                if (weightPos != std::string::npos) {
                    std::string toCoordinates = edgeInfo.substr(0, weightPos);
                    std::string weightStr = edgeInfo.substr(weightPos + 1);

                    try {
                        double weight = std::stod(weightStr);
                        graph.addNode(toCoordinates);
                        graph.addEdge(coordinates, toCoordinates, weight);
                    }
                    catch (const std::exception& e) {
                        std::cerr << "Error parsing edge: " << edgeInfo << " - " << e.what() << "\n";
                    }
                }
                else {
                    std::cerr << "Error: Malformed edge information: " << edgeInfo << "\n";
                }
            }
        }
    }
}

